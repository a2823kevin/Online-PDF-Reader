{
    "family": "opr-task",
    "networkMode": "awsvpc",
    "requiresCompatibilities": ["FARGATE"],
    "cpu": "256",
    "memory": "512",
    "runtimePlatform": {
      "cpuArchitecture": "X86_64",
      "operatingSystemFamily": "LINUX"
    },
    "containerDefinitions": [
      {
        "name": "opr-server",
        "cpu": 0,
        "portMappings": [
          {
            "containerPort": 80,
            "hostPort": 80,
            "protocol": "tcp",
            "name": "opr-server-80-tcp",
            "appProtocol": "http"
          }
        ],
        "essential": true
      }
    ]
  }
  