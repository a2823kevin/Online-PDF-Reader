package edu.proj.onlinepdfreader.demo.controller;

import edu.proj.onlinepdfreader.utils.AppDatabase;
import edu.proj.onlinepdfreader.utils.ConverterClient;
import org.springframework.web.bind.annotation.*;
import org.springframework.web.multipart.MultipartFile;

import java.io.File;
import java.util.HashMap;

@RestController
@RequestMapping("/pdf")
public class PdfController {

    @PostMapping
    public HashMap<String, String> uploadPdf(@RequestParam("uploadedFile") MultipartFile file) {
        HashMap<String, String> resp = new HashMap<>();
        try {
            File pdfFile = new File("src/assets/pdf/" + file.getOriginalFilename());
            file.transferTo(pdfFile);
            resp = new ConverterClient(".").uploadPDF(pdfFile);
        }
        catch (Exception e) {
            resp.put("status", "Failed");
        }
        return resp;
    }

    @GetMapping("/{pdfId}")
    public HashMap<String, String> getPdf(@PathVariable String pdfId) {
        HashMap<String, String> resp = new HashMap<>();
        try {
            resp = AppDatabase.getInstance().getPdf(pdfId);
        }
        catch (Exception e) {
            resp.put("status", "Failed");
        }
        return resp;
    }

    @DeleteMapping("/{pdfId}")
    public void deletePdf(@PathVariable String pdfId, @SessionAttribute("sessionId") String sessionId) {
        try {
            AppDatabase.getInstance().deletePDF(pdfId, sessionId);
        }
        catch (Exception e) {
            // Handle exception
        }
    }
}